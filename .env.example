# Copy to .env and adjust. Consumed by docker-compose.yml.

# --- PostgreSQL credentials ---
POSTGRES_USER=viper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=viper

# --- Backend ---
# Inside Compose, DATABASE_URL is derived from the POSTGRES_* vars above and
# points at the `db` service. You only need to set it yourself for HYBRID local
# dev (a natively-run backend talking to the Compose Postgres):
#   DATABASE_URL=postgresql+psycopg://viper:change-me@localhost:5432/viper
# With no DATABASE_URL set at all, the backend falls back to the local SQLite file.

# AI Report Builder (optional — leave blank to disable that feature).
ANTHROPIC_API_KEY=
