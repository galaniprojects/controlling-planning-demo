{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(source */bin/activate*)",
      "Bash(python -m pytest *)",
      "Bash(python main.py*)",
      "Bash(python -c *)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npx *)",
      "Bash(pip install -r *)",
      "Bash(sqlite3 *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -X POST http://localhost:*)",
